  "type": "commonjs",
  "main": "index.js",
 "scripts": {
  "install-all": "npm install && cd server && npm install && cd ../client/ai-cold-male-generator && npm install",
  "build": "cd client/ai-cold-male-generator && npm install && npm run build",
  "start": "cd server && npm start",
  "dev": "concurrently \"npm run start:server\" \"npm run start:client\"",
  "start:server": "npm --prefix server run start",
  "start:client": "npm --prefix client/ai-cold-male-generator run dev"
},
